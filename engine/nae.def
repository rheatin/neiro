; Exports for the audio engine DLL — MSVC path.
;
; Keep in sync with nae.map (the GNU version script) and with the Rust
; declarations in rust/src/ffi.rs. Three places, one list, and they drift.
;
; DO NOT let the linker write to this file. An earlier build used
; -Wl,--output-def,nae.def, which made ld overwrite this source with generated
; ordinals and mangled C++ symbols. On MinGW that was invisible because
; nae.map was doing the real work, so the corruption sat unnoticed until the
; MSVC path was read. The linker now writes nowhere near here.

LIBRARY nae
EXPORTS
    NAE_GetEngineCapabilities
    NAE_GetLastError
    NAE_GetLastHresult
    NAE_EnumerateDevices
    NAE_GetDefaultDeviceId
    NAE_FreeString
    NAE_OpenExclusive
    NAE_OpenExclusiveSine
    NAE_PlaySine
    NAE_Close
    NAE_Shutdown
    NAE_OpenFile
    NAE_OpenDop
    NAE_OpenDopDownrated
    NAE_OpenNativeDsd
    NAE_OpenNativeDsdSink
    NAE_PlayNativeDsd
    NAE_PlayDop
    NAE_OpenFileShared
    NAE_OpenFileWithRouting
    NAE_OpenFileWithBuffer
    NAE_Play
    NAE_Seek
    NAE_Position
    NAE_PreloadNext
    NAE_ClearNext
    NAE_SkipToNext
    NAE_GetTrackSerial
    NAE_Duration
    NAE_GetLastErrorText
    NAE_PipelineStats
    NAE_QuerySignalPath
    NAE_QuerySupportedRates
    NAE_QuerySpectrum
NAE_QueryEnvelope
