; N-API imports for the audio engine DLL.
;
; Windows resolves a DLL's imports from the *loading executable's* export
; table, so an addon links against "node.exe" — Electron's executable is also
; called electron.exe, and both export the N-API symbols the module is marked
; with. The loader matches on the DLL name recorded here, so the name has to
; be the host's, not a made-up one.
;
; Only the symbols the engine actually calls are listed. Keeping the list
; explicit means the build fails loudly if a refactor starts depending on a
; newer N-API function than intended, instead of failing at load time on a
; host that does not export it.

LIBRARY node.exe

EXPORTS
    napi_module_register
    napi_get_module_file_name
    napi_create_function
    napi_set_named_property
    napi_get_value_string_utf8
    napi_get_cb_info
    napi_get_undefined
    napi_create_string_utf8
    napi_create_double
    napi_create_int32
    napi_create_uint32
    napi_create_bool
    napi_get_boolean
    napi_create_object
    napi_create_array_with_length
    napi_set_element
    napi_get_array_length
    napi_get_element
    napi_throw_error
    napi_get_last_error_info
    napi_is_exception_pending
    napi_get_and_clear_last_exception
    napi_get_cb_info_arity
    napi_create_reference
    napi_delete_reference
    napi_get_reference_value
