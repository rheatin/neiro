# Build output.
#
# Unanchored on purpose: the repository has more than one — engine/build, plus
# a target/ inside each Rust crate (binding/, base/). A path-specific pattern
# would miss them.
target/
build/
build-*/

# Test fixtures.
#
# Audio files are not source. A DSD sample is 162 MB of one-bit audio; a file
# that size makes clone and history unusable. See test/README.md for what
# belongs here and what the checks need.
test/*.dff
test/*.dsf
test/*.wav
test/*.flac
test/*.aiff
test/*.m4a
test/*.mp3
# tag_check's fixtures, generated by ffmpeg; see AGENTS.md rule 7.
test/tagtmp/

# Editor and OS noise.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Cargo config is machine-specific: the compiler paths are absolute.
.cargo/config.toml
.cargo/config
# The directory itself, so a stray file does not appear as untracked.
**/.cargo/*

# Local overrides. The CMake toolchain path is machine-specific and the file
# most likely to be edited by accident.
*.local
.env
.env.*

# The LGPL FFmpeg fetched by scripts/build-lgpl.ps1 and
# scripts/build-ffmpeg-lgpl-macos.sh. Large, and reproducible from a URL.
vendor/

# Runtime libraries staged beside Base for the Windows host.
base/*.dll
base/*.wav

.cache/
ui/prebuilts/
